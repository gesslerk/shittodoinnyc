# Copy to .env for local runs (never commit .env). In GitHub Actions these are repository secrets.

# Required: the recommendation engine
ANTHROPIC_API_KEY=

# Delivery, pick one:
#   Resend (recommended): free tier, no domain needed when sending to the account owner's address
RESEND_API_KEY=
#   Gmail SMTP: needs 2-step verification on the Google account and an app password
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional
EMAIL_TO=gesslerk@gmail.com
EMAIL_FROM=Shit To Do in NYC <onboarding@resend.dev>

# Optional: Instagram coverage via Apify (see README). Without it the Instagram lane uses search only.
APIFY_TOKEN=

# Optional tuning
# MODEL=claude-opus-5            # default for every stage
# RESEARCH_MODEL=claude-opus-5   # set to claude-sonnet-5 to cut research cost by roughly 60%
# CURATE_MODEL=claude-opus-5
# VERIFY_MODEL=claude-opus-5
# RESEARCH_EFFORT=high           # low | medium | high | xhigh | max
# CURATE_EFFORT=high
# VERIFY_EFFORT=medium
# LANES=music,fights             # run a subset of lanes (default: all)
# SKIP_VERIFY=1                  # skip the fact-check pass (cheaper, less safe)
# DRY_RUN=1                      # build the email into out/ without sending
# FORCE=1                        # ignore the Monday 6am gate
